# Copy to .env and fill in. Leave a feature's values blank to hide its button.

# Email (Mailgun). Sandbox domains only deliver to authorized recipients.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.example.com
MAILGUN_FROM=Photobooth <photobooth@mg.example.com>
MAILGUN_REGION=us            # us or eu

# Text message with a link to the photos (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Link phones use to reach the board (blank = auto-detect LAN IP)
PUBLIC_BASE_URL=

# Instax Mini Link printing
PRINTER_ENABLED=true
PRINTER_DEVICE_NAME=INSTAX-
PRINTER_DEVICE_ADDRESS=
# Optional shared secret between the app and the host print helper (set the same value for both)
PRINT_HELPER_TOKEN=
# Blank = docker host, port 8765
PRINT_HELPER_URL=

# Booth behaviour
PHOTOS_PER_SESSION=4
COUNTDOWN_SECONDS=3
KEEP_SESSIONS_HOURS=24
